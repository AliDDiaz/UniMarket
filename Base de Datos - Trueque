CREATE TABLE usuarios (

	id INT                  GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	nombre VARCHAR(100)     NOT NULL,
	correo VARCHAR(150)     NOT NULL UNIQUE,
	telefono VARCHAR(20)    NOT NULL,
	contrasena VARCHAR(200) NOT NULL,
	rol VARCHAR(20)         NOT NULL DEFAULT 'Estudiante' CHECK (rol IN ('Estudiante', 'Administrador')),
	activo BOOLEAN          NOT NULL DEFAULT TRUE,
	fecha_registro TIMESTAMP NOT NULL DEFAULT NOW(),
	foto BYTEA

);

CREATE TABLE publicaciones (

	id          INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	vendedor_id INT           NOT NULL REFERENCES usuarios(id),
	titulo      VARCHAR(120)  NOT NULL,
	descripcion VARCHAR(500),
	precio      NUMERIC(12,2) NOT NULL CHECK (precio > 0),
	stock       INT           NOT NULL CHECK (stock >= 0),
	activo      BOOLEAN       NOT NULL DEFAULT TRUE

);

CREATE TABLE solicitudes_compra (

	id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	publicacion_id INT         NOT NULL REFERENCES publicaciones(id),
	comprador_id   INT         NOT NULL REFERENCES usuarios(id),
	cantidad       INT         NOT NULL                     CHECK (cantidad > 0),
	estado         VARCHAR(20) NOT NULL DEFAULT 'Pendiente' CHECK (estado IN ('Pendiente', 'Aceptada', 'Rechazada')),
	fecha          TIMESTAMP   NOT NULL DEFAULT NOW()

);

SELECT * FROM usuarios;
SELECT * FROM publicaciones;
