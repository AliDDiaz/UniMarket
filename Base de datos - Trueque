CREATE TABLE publicaciones (

	id            INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	vendedor_id   INT           NOT NULL REFERENCES usuarios(id),
	titulo        VARCHAR(120)  NOT NULL,
	descripcion   VARCHAR(500),
	precio        NUMERIC(12,2),
	stock         INT           NOT NULL CHECK (stock >= 0),
	activo        BOOLEAN       NOT NULL DEFAULT TRUE,
	imagen        BYTEA,
	modalidad     VARCHAR(10)   NOT NULL DEFAULT 'Venta' CHECK (modalidad IN ('Venta', 'Trueque', 'Ambas')),
	trueque_busca VARCHAR(300),

	CONSTRAINT publicaciones_precio_modalidad_check
		CHECK ((modalidad = 'Trueque' AND precio IS NULL)
		    OR (modalidad IN ('Venta', 'Ambas') AND precio > 0)),
	CONSTRAINT publicaciones_trueque_busca_check
		CHECK (modalidad = 'Venta'
		    OR (trueque_busca IS NOT NULL AND btrim(trueque_busca) <> ''))

);

CREATE TABLE solicitudes_compra (

	id              INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	publicacion_id  INT           NOT NULL REFERENCES publicaciones(id),
	comprador_id    INT           NOT NULL REFERENCES usuarios(id),
	cantidad        INT           NOT NULL CHECK (cantidad > 0),
	precio_unitario NUMERIC(12,2),
	tipo            VARCHAR(10)   NOT NULL DEFAULT 'Compra' CHECK (tipo IN ('Compra', 'Trueque')),
	oferta_trueque  VARCHAR(300),
	estado          VARCHAR(20)   NOT NULL DEFAULT 'Pendiente' CHECK (estado IN ('Pendiente', 'Aceptada', 'Rechazada')),
	fecha           TIMESTAMP     NOT NULL DEFAULT NOW(),

	CONSTRAINT solicitudes_compra_tipo_datos_check
		CHECK ((tipo = 'Compra' AND precio_unitario > 0)
		    OR (tipo = 'Trueque' AND precio_unitario IS NULL
		        AND oferta_trueque IS NOT NULL AND btrim(oferta_trueque) <> ''))

);
